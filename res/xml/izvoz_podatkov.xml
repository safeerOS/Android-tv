<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: brez teh pravil bi prenos z naprave na napravo kopiral tudi podatke aplikacije
     (zetone Safeer Linka, seznanjene naprave). allowBackup="false" tega na novejsem Androidu ne
     prepreci vec, zato izrecno izkljucimo vse. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
