    <string name="os_host_naslov_napaka">To ni videti kot naslov. Primer: moj-streznik.si</string>
    <string name="os_host_povezujem">Povezujem se s strežnikom ...</string>
    <string name="os_host_koda">Koda s strežnika</string>
    <string name="os_host_koda_opis">Safeer Link na tistem strežniku pokaže kodo. Vtipkaj jo sem. Koda nikoli ne potuje po omrežju; obe strani samo dokažeta, da jo poznata.</string>
    <string name="os_host_koda_namig">koda z zaslona</string>
    <string name="os_host_poveziSe">Poveži</string>
    <string name="os_host_povezan">Povezano s %1$s. Datoteke in ukazi zdaj potujejo prek interneta do tvojega strežnika.</string>
    <string name="os_host_napacna_koda">Napačna koda ali pa je vmes kdo drug. Poskusi znova.</string>
    <string name="os_host_prevec_poskusov">Preveč poskusov. Na strežniku začni seznanitev znova.</string>
    <string name="os_host_ni_odgovora">Strežnik se ni oglasil. Preveri naslov, da na njem teče Safeer Link in da so vrata odprta.</string>
    <string name="os_host_oddaljen_vprasanje">Host je %1$s, zunaj domačega omrežja. Se vrnem na domače omrežje? Žeton za tisti strežnik pozabimo; seznaniš se lahko kadarkoli znova.</string>
