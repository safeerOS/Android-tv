<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SafeerOs" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/os_ozadje</item>
        <item name="android:colorBackground">@color/os_ozadje</item>
        <item name="android:textColorPrimary">@color/os_besedilo</item>
        <item name="android:textColorSecondary">@color/os_umirjeno</item>
        <item name="android:colorAccent">@color/os_mint</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowContentTransitions">false</item>
    </style>
    <style name="Theme.SafeerOs.Predvajalnik" parent="Theme.SafeerOs">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    <style name="Os.Naslov" parent="">
        <item name="android:textColor">@color/os_besedilo</item>
        <item name="android:textSize">26sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Os.Nadnaslov" parent="">
        <item name="android:textColor">@color/os_mint</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Os.Kartica.Naslov" parent="">
        <item name="android:textColor">@color/os_besedilo</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="Os.Kartica.Opis" parent="">
        <item name="android:textColor">@color/os_umirjeno</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="Os.Tipka" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/os_tipka</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textColor">@color/os_besedilo</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Os.Pomoc" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:textColor">@color/os_umirjeno</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Os.Pozdrav.Naslov" parent="">
        <item name="android:textColor">@color/os_besedilo</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Os.Pozdrav.Podnaslov" parent="">
        <item name="android:textColor">@color/os_umirjeno</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Os.Plosca.Naslov" parent="">
        <item name="android:textColor">@color/os_besedilo</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
