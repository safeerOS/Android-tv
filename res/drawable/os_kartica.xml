<?xml version="1.0" encoding="utf-8"?>
<!-- Kartica Safeer OS (docs/TV-UI.md). Mirna, dokler je ne izberes: brez robov, samo temna ploskev.
     Ob fokusu z daljinca dobi 2 dp mint obrobo in nezen mint sij okrog nje, da z dvometrske
     razdalje takoj vidis, kje si. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/os_sij"/>
                    <corners android:radius="18dp"/>
                </shape>
            </item>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/os_kartica_dvignjena"/>
                    <stroke android:width="2dp" android:color="@color/os_mint"/>
                    <corners android:radius="14dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/os_sij"/>
                    <corners android:radius="18dp"/>
                </shape>
            </item>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/os_kartica_dvignjena"/>
                    <stroke android:width="2dp" android:color="@color/os_mint"/>
                    <corners android:radius="14dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/os_kartica"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
</selector>
