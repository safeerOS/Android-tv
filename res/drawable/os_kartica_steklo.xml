<?xml version="1.0" encoding="utf-8"?>
<!-- Steklena kartica Safeer OS: polprosojno temno modro ozadje, mehka obroba, ob fokusu 2 dp mint obroba. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/os_kartica_steklo_fokus"/>
            <stroke android:width="2dp" android:color="@color/os_mint"/>
            <corners android:radius="@dimen/os_kot_kartica"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/os_kartica_steklo_fokus"/>
            <stroke android:width="2dp" android:color="@color/os_mint"/>
            <corners android:radius="@dimen/os_kot_kartica"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/os_kartica_steklo"/>
            <stroke android:width="1dp" android:color="@color/os_kartica_obroba"/>
            <corners android:radius="@dimen/os_kot_kartica"/>
        </shape>
    </item>
</selector>
