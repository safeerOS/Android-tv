<?xml version="1.0" encoding="utf-8"?>
<!-- Iskalno polje v Programih racunalnika; pod fokusom dobi mint obrobo, da se vidi, kam gre tipkanje. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/osKarticaDvignjena"/>
            <stroke android:width="2dp" android:color="?attr/osMint"/>
            <corners android:radius="999dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/osKartica"/>
            <stroke android:width="1dp" android:color="?attr/osCrta"/>
            <corners android:radius="999dp"/>
        </shape>
    </item>
</selector>
