<?xml version="1.0" encoding="utf-8"?>
<!-- Gumb za hiter dostop: zaobljena kvadratna ploščica z ikono in napisom. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/os_kartica_steklo_fokus"/>
            <stroke android:width="2dp" android:color="@color/os_mint"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/os_kartica_steklo_fokus"/>
            <stroke android:width="2dp" android:color="@color/os_mint"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A2433"/>
            <stroke android:width="1dp" android:color="#2A3D52"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
</selector>
