<?xml version="1.0" encoding="utf-8"?>
<!-- Menijska postavka stranskega menija Safeer OS.
     Ob izbiri ali fokusu z daljinca dobi poudarjeno ozadje in mint obrobo. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/os_meni_fokus_ozadje"/>
            <stroke android:width="2dp" android:color="@color/os_mint"/>
            <corners android:radius="@dimen/os_kot_meni"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/os_meni_izbran_ozadje"/>
            <stroke android:width="1.5dp" android:color="@color/os_mint"/>
            <corners android:radius="@dimen/os_kot_meni"/>
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/os_meni_izbran_ozadje"/>
            <stroke android:width="1.5dp" android:color="@color/os_mint"/>
            <corners android:radius="@dimen/os_kot_meni"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/os_meni_fokus_ozadje"/>
            <stroke android:width="2dp" android:color="@color/os_mint"/>
            <corners android:radius="@dimen/os_kot_meni"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <corners android:radius="@dimen/os_kot_meni"/>
        </shape>
    </item>
</selector>
