<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#090D15"/>
            <stroke android:width="3dp" android:color="#57D6AD"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#090D15"/>
            <stroke android:width="3dp" android:color="#57D6AD"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#57D6AD"/></shape>
    </item>
    <item><shape android:shape="rectangle"><solid android:color="#101821"/></shape></item>
</selector>
