<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/osMeniIzbranOzadje" />
            <stroke android:width="3dp" android:color="?attr/osMint" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/osSij" />
            <stroke android:width="2dp" android:color="?attr/osMint" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/osKartica" />
            <stroke android:width="1.8dp" android:color="?attr/osMint" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
