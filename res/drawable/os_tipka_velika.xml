<?xml version="1.0" encoding="utf-8"?>
<!-- Tipka navidezne tipkovnice: mirna temna ploscica, ob fokusu mint obroba - z dveh metrov
     mora biti takoj jasno, katera tipka je izbrana. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/os_kartica_dvignjena"/>
            <stroke android:width="2dp" android:color="@color/os_mint"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/os_mint_temna"/>
            <stroke android:width="2dp" android:color="@color/os_mint"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC101821"/>
            <stroke android:width="1dp" android:color="@color/os_crta"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
</selector>
