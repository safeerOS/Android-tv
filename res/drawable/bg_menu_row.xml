<?xml version="1.0" encoding="utf-8"?>
<!-- Vrstica menija na TV: zaobljen pravokotnik, ob fokusu mint obroba (elipsa se na sirokih vrsticah raztegne). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_color">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="#1A2A22" />
                    <stroke android:width="2dp" android:color="#54D6A5" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="@color/bg_secondary" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
