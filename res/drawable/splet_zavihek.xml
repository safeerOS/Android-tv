<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/osMeniIzbranOzadje"/>
            <corners android:topLeftRadius="12dp" android:topRightRadius="12dp"/>
            <stroke android:width="2dp" android:color="?attr/osMint"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/osKarticaDvignjena"/>
            <corners android:topLeftRadius="12dp" android:topRightRadius="12dp"/>
            <stroke android:width="2dp" android:color="?attr/osMint"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/osKartica"/>
            <corners android:topLeftRadius="12dp" android:topRightRadius="12dp"/>
            <stroke android:width="1dp" android:color="?attr/osCrta"/>
        </shape>
    </item>
</selector>
