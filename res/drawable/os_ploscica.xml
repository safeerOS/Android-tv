<?xml version="1.0" encoding="utf-8"?>
<!-- Ploscica aplikacije: kot na telefonu je vidna samo ikona, brez skatle okrog nje. Ob fokusu z
     daljinca se pod njo prizge mehka mint podlaga, da z dveh metrov takoj vidis, kje si. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/os_kartica_dvignjena"/>
            <stroke android:width="2dp" android:color="@color/os_mint"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/os_kartica_dvignjena"/>
            <stroke android:width="2dp" android:color="@color/os_mint"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
</selector>
