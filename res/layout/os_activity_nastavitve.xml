<?xml version="1.0" encoding="utf-8"?>
<!-- Nastavitve Safeer OS: vrstice z naslovom in trenutnim stanjem, berljive z razdalje. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/koren"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/os_rob"
    android:paddingEnd="@dimen/os_rob"
    android:paddingTop="36dp"
    android:paddingBottom="24dp">

    <TextView
        style="@style/Os.Nadnaslov"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/os_app_name"/>
    <TextView
        android:id="@+id/naslov"
        style="@style/Os.Naslov"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/os_nastavitve"/>
    <TextView
        android:id="@+id/opomba"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/os_umirjeno"
        android:textSize="14sp"/>

    <ListView
        android:id="@+id/seznam"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="18dp"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none"/>

</LinearLayout>
