<?xml version="1.0" encoding="utf-8"?>
<!-- Nastavitve Safeer OS: vrstice z naslovom in trenutnim stanjem, berljive z razdalje.
     Glava je enaka kot pri Aplikacijah, Datotekah in Napravah: ikona, nadnaslov, naslov. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/koren"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/os_rob"
    android:paddingEnd="@dimen/os_rob"
    android:paddingTop="28dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/os_ikona_nastavitve"
            android:contentDescription="@null"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical">
            <TextView
                style="@style/Os.Nadnaslov"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/os_app_name"/>
            <TextView
                android:id="@+id/naslov"
                style="@style/Os.Naslov"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/os_nastavitve"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/opomba"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/os_umirjeno"
        android:textSize="14sp"/>

    <ListView
        android:id="@+id/seznam"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="18dp"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none"/>

</LinearLayout>
