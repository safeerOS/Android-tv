<?xml version="1.0" encoding="utf-8"?>
<!-- Ena kartica aplikacije/programa v mrezi. Tako nizka, da gredo na 1080p televizorju tri
     vrste v celoti nad namig na dnu - prej je bila tretja vrsta odrezana.
     Brez temne ploskve: ikone stojijo naravnost na ozadju (temni pravokotniki so ga trgali).
     Izbiro z daljincem narise izbirnik mreze (mint okvir), zato ploskev ni potrebna.
     Senca pod imenom ohrani besedilo berljivo tudi na svetlem delu ozadja.
     Ime ima vedno dve vrstici visine (lines=2, lastnik 1. 11. 2026): ime v dveh vrsticah (Mimi Sound Personalization) je
     naredilo visjo kartico in GridView je ob drsenju iz prve v tretjo vrsto premaknil to kartico.
     Druga vrstica je kartico povisala za ~14 dp in tretja vrsta ni vec sla na zaslon - ob prehodu vanjo se je premaknila
     cela mreza (lastnik 1. 11. 2026 09:50). Zato manj odmika in ikona 46 dp (skupaj -12 dp). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="4dp">
    <ImageView
        android:id="@+id/ikona"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:scaleType="fitCenter"
        android:contentDescription="@null"/>
    <TextView
        android:id="@+id/ime"
        style="@style/Os.Kartica.Naslov"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:lines="2"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:textSize="12sp"/>
</LinearLayout>
