<?xml version="1.0" encoding="utf-8"?>
<!-- Majhna kartica v vrsti Zacni: ikona, ime in (samo kadar je kaj povedati) ena mint vrstica
     stanja. Brez opisov - na zaslonu 960x540 dp so prav opisi pojedli visino, da tri vrste niso
     sle skupaj. Podlage ni: ploscica se prizge sele ob fokusu, tako kot pri aplikacijah. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="134dp"
    android:layout_height="98dp"
    android:layout_marginEnd="12dp"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/os_ploscica"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:clickable="true">
    <ImageView
        android:id="@+id/ikona"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:contentDescription="@null"/>
    <TextView
        android:id="@+id/naslov"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingMultiplier="0.95"
        android:textColor="@color/os_besedilo"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium"/>
    <TextView
        android:id="@+id/stanje"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/os_mint"
        android:textSize="11sp"
        android:visibility="gone"/>
</LinearLayout>
