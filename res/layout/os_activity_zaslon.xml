<?xml version="1.0" encoding="utf-8"?>
<!-- Zaslon racunalnika: slika cez ves zaslon, sporocilo o stanju in merilniki. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/koren"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <SurfaceView
        android:id="@+id/povrsina"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <TextView
        android:id="@+id/sporocilo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="24dp"
        android:textColor="@color/os_besedilo"
        android:textSize="18sp"
        android:lineSpacingExtra="4dp"/>

    <!-- Navidezna tipkovnica: prizge se na zahtevo, sicer je ni. Prosojna podlaga, da se vidi,
         kam pisemo. -->
    <LinearLayout
        android:id="@+id/tipkovnica"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:orientation="vertical"
        android:background="@drawable/os_tipkovnica_podlaga"
        android:padding="8dp"
        android:visibility="gone"/>

    <!-- Namig o upravljanju: pokaze se ob zacetku seje in ob preklopu nacina, nato izgine. -->
    <TextView
        android:id="@+id/namig"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="18dp"
        android:background="@drawable/os_znacka"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center"
        android:textColor="@color/os_besedilo"
        android:textSize="13sp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/meritve"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="18dp"
        android:background="@drawable/os_znacka"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textColor="@color/os_umirjeno"
        android:textSize="12sp"
        android:visibility="gone"/>
</FrameLayout>
