<?xml version="1.0" encoding="utf-8"?>
<!-- Programi racunalnika: glava (kateri racunalnik), mreza programov, sporocilo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/koren"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/os_rob"
    android:paddingEnd="@dimen/os_rob"
    android:paddingTop="28dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/glavaIkona"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/os_ikona_racunalnik"
            android:contentDescription="@null"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/nadnaslov"
                style="@style/Os.Nadnaslov"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/naslov"
                style="@style/Os.Naslov"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>
        <TextView
            android:id="@+id/racunalnik"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/os_znacka"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="@color/os_umirjeno"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- Iskanje po imenu in skupine: sto programov brez tega ni seznam, ampak iskanje igle. -->
    <LinearLayout
        android:id="@+id/orodja"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/iskanje"
            android:importantForAutofill="no"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:background="@drawable/os_iskanje"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:singleLine="true"
            android:maxLines="1"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:hint="@string/os_programi_isci"
            android:textColorHint="@color/os_umirjeno"
            android:textColor="@color/os_besedilo"
            android:textCursorDrawable="@null"
            android:textSize="14sp"/>

        <HorizontalScrollView
            android:id="@+id/skupineDrsnik"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/skupine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>
    </LinearLayout>

    <GridView
        android:id="@+id/mreza"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp"
        android:numColumns="6"
        android:horizontalSpacing="12dp"
        android:verticalSpacing="12dp"
        android:listSelector="@drawable/os_izbor_vrstice"
        android:scrollbars="none"
        android:fadingEdgeLength="24dp"
        android:requiresFadingEdge="vertical"/>

    <TextView
        android:id="@+id/sporocilo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/os_umirjeno"
        android:textSize="15sp"
        android:lineSpacingExtra="4dp"
        android:visibility="gone"/>
</LinearLayout>
