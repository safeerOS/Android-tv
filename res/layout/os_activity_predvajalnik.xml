<?xml version="1.0" encoding="utf-8"?>
<!-- Predvajalnik: slika cez ves zaslon, spodaj prekritje z imenom, potekom in casom (skrije se samo). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">
    <SurfaceView
        android:id="@+id/povrsina"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:id="@+id/glasbaKartica"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">
        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/os_ikona_glasba"
            android:contentDescription="@null"/>
        <TextView
            android:id="@+id/glasbaIme"
            style="@style/Os.Naslov"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/prekritje"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/os_prekritje"
        android:orientation="vertical"
        android:padding="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/stanjeIkona"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/os_ikona_pavza"
                android:contentDescription="@null"/>
            <TextView
                android:id="@+id/ime"
                style="@style/Os.Kartica.Naslov"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"/>
            <TextView
                android:id="@+id/cas"
                style="@style/Os.Kartica.Opis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"/>
        </LinearLayout>
        <ProgressBar
            android:id="@+id/potek"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="14dp"
            android:max="1000"
            android:progressTint="@color/os_mint"
            android:progressBackgroundTint="@color/os_crta"/>
        <TextView
            android:id="@+id/namig"
            style="@style/Os.Kartica.Opis"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/os_predvajalnik_namig"/>
    </LinearLayout>
</FrameLayout>
