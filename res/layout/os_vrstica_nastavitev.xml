<?xml version="1.0" encoding="utf-8"?>
<!-- Vrstica nastavitve na ozkem zaslonu (telefon): stanje je pod razlago, da naslov ostane cel.
     Siroki zasloni (TV, tablica) uporabijo layout-w600dp: stanje na desni. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">
    <ImageView
        android:id="@+id/ikona"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:contentDescription="@null"/>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/ime"
            style="@style/Os.Kartica.Naslov"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="17sp"/>
        <TextView
            android:id="@+id/opis"
            style="@style/Os.Kartica.Opis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:textSize="13sp"/>
        <TextView
            android:id="@+id/stanje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="?attr/osMint"
            android:textSize="14sp"/>
    </LinearLayout>
</LinearLayout>
