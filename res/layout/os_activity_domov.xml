<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drsnik"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/os_ozadje"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/os_rob"
        android:paddingEnd="@dimen/os_rob"
        android:paddingTop="18dp"
        android:paddingBottom="24dp">

        <!-- Glava: znak, ime, stanje Linka, ura -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/os_znak"
                android:contentDescription="@null"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/os_app_name"
                    android:textColor="@color/os_besedilo"
                    android:textSize="22sp"
                    android:letterSpacing="0.08"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/os_podnaslov"
                    android:textColor="@color/os_umirjeno"
                    android:textSize="12sp"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/stanjeOkvir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/os_znacka"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">
                <View
                    android:id="@+id/stanjePika"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/os_pika"/>
                <TextView
                    android:id="@+id/stanjeBesedilo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/os_stanje_povezujem"
                    android:textColor="@color/os_besedilo"
                    android:textSize="12sp"/>
            </LinearLayout>
            <TextView
                android:id="@+id/ura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:textColor="@color/os_umirjeno"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>

        <!-- Zacni -->
        <TextView
            style="@style/Os.Nadnaslov"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/os_odsek_zacni"/>
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none"
            android:clipToPadding="false">
            <LinearLayout
                android:id="@+id/vrstaZacni"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>

        <!-- Spletne aplikacije (spletna stran kot aplikacija) -->
        <TextView
            style="@style/Os.Nadnaslov"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/os_odsek_spletne"/>
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none"
            android:clipToPadding="false">
            <LinearLayout
                android:id="@+id/vrstaSpletne"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>

        <!-- Naprave -->
        <TextView
            style="@style/Os.Nadnaslov"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/os_odsek_naprave"/>
        <TextView
            android:id="@+id/napraveOpomba"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/os_ni_naprav"
            android:textColor="@color/os_umirjeno"
            android:textSize="13sp"/>
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none"
            android:clipToPadding="false">
            <LinearLayout
                android:id="@+id/vrstaNaprave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>

        <!-- Aplikacije -->
        <TextView
            style="@style/Os.Nadnaslov"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/os_odsek_aplikacije"/>
        <HorizontalScrollView
            android:id="@+id/aplikacijeDrsnik"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none"
            android:clipToPadding="false">
            <LinearLayout
                android:id="@+id/vrstaAplikacije"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/opombaSpodaj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="@color/os_opozorilo"
            android:textSize="13sp"
            android:visibility="gone"/>
    </LinearLayout>
</ScrollView>
