<?xml version="1.0" encoding="utf-8"?>
<!-- Magnet povezave: vnos povezave, vsebina (predvajaj/prenesi), prenosi in kratko opozorilo spodaj. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/koren"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/os_rob"
    android:paddingEnd="@dimen/os_rob"
    android:paddingTop="24dp"
    android:paddingBottom="14dp">

    <TextView
        style="@style/Os.Nadnaslov"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SAFEER MEDIA · MAGNET"/>
    <TextView
        style="@style/Os.Naslov"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/magnet_naslov"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/polje"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/os_kartica_mirna"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:hint="magnet:?xt=urn:btih:…"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColor="?attr/osBesedilo"
            android:textColorHint="?attr/osUmirjeno"
            android:textSize="14sp"/>
        <Button
            android:id="@+id/odpri"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/os_hitri_gumb"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/magnet_odpri"
            android:textAllCaps="false"
            android:textColor="?attr/osBesedilo"/>
    </LinearLayout>

    <TextView
        android:id="@+id/sporocilo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="?attr/osUmirjeno"
        android:textSize="14sp"
        android:visibility="gone"/>

    <ScrollView
        android:id="@+id/drsnik"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp">
        <LinearLayout
            android:id="@+id/seznam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="?attr/osUmirjeno"
        android:textSize="12sp"
        android:text="@string/magnet_opomba"/>
</LinearLayout>
