<?xml version="1.0" encoding="utf-8"?>
<!-- Videz: levo seznam ozadij, desno se vidi izbrano ozadje v zivo, spodaj drsnik zatemnitve. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/koren"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/os_rob"
    android:paddingEnd="@dimen/os_rob"
    android:paddingTop="36dp"
    android:paddingBottom="18dp">

    <TextView
        style="@style/Os.Nadnaslov"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/os_app_name"/>
    <TextView
        style="@style/Os.Naslov"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/os_videz"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/os_umirjeno"
        android:textSize="14sp"
        android:text="@string/os_ozadje_opis"/>

    <ListView
        android:id="@+id/seznam"
        android:layout_width="392dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none"/>

    <!-- Zatemnitev: drsnik se premika z levo in desno, ucinek se vidi takoj. -->
    <LinearLayout
        android:layout_width="392dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingTop="10dp"
        android:background="@drawable/os_crta_zgoraj"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textColor="@color/os_besedilo"
                android:textSize="15sp"
                android:text="@string/os_zatemnitev"/>
            <TextView
                android:id="@+id/odstotek"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/os_mint"
                android:textSize="15sp"/>
        </LinearLayout>
        <SeekBar
            android:id="@+id/drsnik"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:focusable="true"
            android:focusableInTouchMode="true"/>
        <TextView
            android:id="@+id/pomoc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/os_umirjeno"
            android:textSize="12sp"
            android:text="@string/os_zatemnitev_opis"/>
    </LinearLayout>
</LinearLayout>
