<?xml version="1.0" encoding="utf-8"?>
<!-- Datoteke z racunalnika: glava (kje smo), seznam map in datotek, sporocilo (prazno, napaka, navodilo). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/koren"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/os_rob"
    android:paddingEnd="@dimen/os_rob"
    android:paddingTop="28dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/os_ikona_datoteke"
            android:contentDescription="@null"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/nadnaslov"
                style="@style/Os.Nadnaslov"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/os_datoteke"/>
            <TextView
                android:id="@+id/naslov"
                style="@style/Os.Naslov"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="start"/>
        </LinearLayout>
        <TextView
            android:id="@+id/racunalnik"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/os_znacka"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="?attr/osUmirjeno"
            android:textSize="12sp"/>
        <ImageButton
            android:id="@+id/preklopPogleda"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:padding="10dp"
            android:background="@drawable/os_meni_postavka"
            android:src="@drawable/os_ikona_mreza"
            android:contentDescription="@string/os_galerija_pokazi_mrezo"
            android:focusable="true"/>
    </LinearLayout>

    <!-- Iskanje po imenu v trenutni mapi (enako kot pri Aplikacijah). -->
    <EditText
        android:id="@+id/iskanje"
        android:importantForAutofill="no"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/os_iskanje"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:singleLine="true"
        android:maxLines="1"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:hint="@string/os_programi_isci"
        android:textColorHint="?attr/osUmirjeno"
        android:textColor="?attr/osBesedilo"
        android:textCursorDrawable="@null"
        android:textSize="14sp"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp">

        <ListView
            android:id="@+id/seznam"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="4dp"
            android:listSelector="@drawable/os_izbor_vrstice"
            android:scrollbars="none"
            android:fadingEdgeLength="24dp"
            android:requiresFadingEdge="vertical"/>

        <!-- Galerija: vrstice sticic po dnevih (glava dneva cez vso sirino, nato vrste kvadratov). -->
        <ListView
            android:id="@+id/mreza"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:scrollbars="none"
            android:clipToPadding="false"/>

        <TextView
            android:id="@+id/sporocilo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:textColor="?attr/osUmirjeno"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            android:visibility="gone"/>
    </FrameLayout>

    <!-- Namig o zadrzanem OK: brez njega je odpiranje na racunalniku skrita moznost. -->
    <TextView
        android:id="@+id/namigDrzi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="?attr/osUmirjeno"
        android:textSize="12sp"
        android:visibility="gone"/>

</LinearLayout>
