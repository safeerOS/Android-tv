<?xml version="1.0" encoding="utf-8"?>
<!-- Aplikacija (spletna ali s televizorja): velika ikona, ime pod njo - kot na telefonu. Skatle
     okrog ikone ni; ploscica se prizge sele ob fokusu. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="124dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="16dp"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/os_ploscica"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:clickable="true">
    <ImageView
        android:id="@+id/ikona"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:scaleType="fitCenter"
        android:contentDescription="@null"/>
    <TextView
        android:id="@+id/ime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:minLines="2"
        android:maxLines="2"
        android:lineSpacingMultiplier="0.95"
        android:ellipsize="end"
        android:textColor="@color/os_besedilo"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"/>
</LinearLayout>
