<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Predvajalnik: zaslon in omrezje ostaneta budna med predvajanjem z racunalnika. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Zeton Safeer Linka dobi od Safeer Browserja na istem televizorju (dovoljenje istega podpisa). -->
    <uses-permission android:name="si.safeer.tv.permission.LINK" />

    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <package android:name="si.safeer.tv" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".SafeerOs"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.SafeerOs"
        android:allowBackup="false"
        android:supportsRtl="false">

        <activity
            android:name=".DomovActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Datoteke z racunalnika (Safeer Control deli mape), predvajalnik in slike. -->
        <activity android:name=".DatotekeActivity" android:exported="false" android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation" />
        <activity android:name=".PredvajalnikActivity" android:exported="false" android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation"
            android:theme="@style/Theme.SafeerOs.Predvajalnik" />
        <activity android:name=".SlikaActivity" android:exported="false" android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation"
            android:theme="@style/Theme.SafeerOs.Predvajalnik" />
    </application>
</manifest>
