<?xml version="1.0" encoding="utf-8"?>
<!-- Datoteke z racunalnika: glava (kje smo), seznam map in datotek, sporocilo (prazno, napaka, navodilo). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ozadje"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingEnd="48dp"
    android:paddingTop="28dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ikona_datoteke"
            android:contentDescription="@null"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/nadnaslov"
                style="@style/Nadnaslov"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/datoteke"/>
            <TextView
                android:id="@+id/naslov"
                style="@style/Naslov"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="start"/>
        </LinearLayout>
        <TextView
            android:id="@+id/racunalnik"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/znacka"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="@color/umirjeno"
            android:textSize="12sp"/>
    </LinearLayout>

    <ListView
        android:id="@+id/seznam"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="20dp"
        android:divider="@null"
        android:dividerHeight="4dp"
        android:listSelector="@drawable/izbor_vrstice"
        android:scrollbars="none"
        android:fadingEdgeLength="24dp"
        android:requiresFadingEdge="vertical"/>

    <TextView
        android:id="@+id/sporocilo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/umirjeno"
        android:textSize="15sp"
        android:lineSpacingExtra="4dp"
        android:visibility="gone"/>
</LinearLayout>
