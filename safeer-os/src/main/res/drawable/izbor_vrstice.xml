<?xml version="1.0" encoding="utf-8"?>
<!-- Izbrana vrstica seznama (ListView na televizorju): dvignjena kartica z mint obrobo, kot fokus kartic. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kartica_dvignjena"/>
            <stroke android:width="2dp" android:color="@color/mint"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kartica_dvignjena"/>
            <stroke android:width="2dp" android:color="@color/mint"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kartica_dvignjena"/>
            <stroke android:width="2dp" android:color="@color/mint"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <item><color android:color="#00000000"/></item>
</selector>
