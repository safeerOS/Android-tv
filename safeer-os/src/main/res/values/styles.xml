<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SafeerOs" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/ozadje</item>
        <item name="android:colorBackground">@color/ozadje</item>
        <item name="android:textColorPrimary">@color/besedilo</item>
        <item name="android:textColorSecondary">@color/umirjeno</item>
        <item name="android:colorAccent">@color/mint</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowContentTransitions">false</item>
    </style>
    <style name="Naslov">
        <item name="android:textColor">@color/besedilo</item>
        <item name="android:textSize">26sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Nadnaslov">
        <item name="android:textColor">@color/mint</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Kartica.Naslov" parent="">
        <item name="android:textColor">@color/besedilo</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="Kartica.Opis" parent="">
        <item name="android:textColor">@color/umirjeno</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
