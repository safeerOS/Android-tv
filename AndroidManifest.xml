<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="si.safeer.tv"
    android:versionCode="208"
    android:versionName="2.1.99">

    <uses-sdk
        android:minSdkVersion="28"
        android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Sorodne aplikacije Safeer na istem televizorju (Safeer OS) dobijo zeton Safeer Linka samo, ce so podpisane z istim kljucem. -->
    <permission
        android:name="si.safeer.tv.permission.LINK"
        android:protectionLevel="signature" />
    <!-- Safeer Link: stran ali ukaz z druge naprave odpre brskalnik, tudi ko ni v ospredju
         (Android 10+ zagon iz ozadja dovoli le prek obvestila s celozaslonsko namero). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Za crno ozadje domacega zaslona televizorja; spremeni ga samo uporabnik v meniju. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- mDNS: brez tega Android na Wi-Fi zavrze multicast in Safeer Hub ni najden. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Safeer Cast: sprejemnik tece kot storitev v ospredju, da povezava z vozliscem zdrzi -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Samo za prebujanje brskalnika, ko telefon poslje povezavo (Safeer Cast).
         Android 11 brez tega zagon dejavnosti iz ozadja zavrne. Dodeli ga uporabnik. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Safeer Link: televizor strezi seznanjenim napravam v hisi tudi, ko brskalnik ni odprt.
         "connectedDevice" je edina vrsta storitve, ki jo Android dovoli zagnati po vklopu naprave. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Safeer Scit: filter DNS za ves televizor (VpnService; Android 14 zahteva tip systemExempted za VPN) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.type.television" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <supports-screens
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="true"
        android:xlargeScreens="true"
        android:anyDensity="true" />

    <!-- Daljinec Safeer Linka (Safeer Control): seznam aplikacij, ki jih je mogoce zagnati,
         in aplikacije, ki znajo odpreti spletno povezavo (npr. SmartTube za YouTube).
         Brez tega Android 11+ seznam skrije in daljinec bi videl le sistemske aplikacije. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/safeer_tv_banner"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true">

        <activity
            android:name="si.safeer.tv.MainActivity"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher"
            android:banner="@drawable/safeer_tv_banner"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|density"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- Default Web Browser Handlers (scheme-only: Android BROWSER role) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" android:host="*" />
                <data android:scheme="https" android:host="*" />
            </intent-filter>
            <!-- Dokumenti PDF z naprave (prenosi, upravitelj datotek, e-posta) se odprejo v vgrajenem pregledovalniku -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.WEB_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Safeer Cast: sprejemnik povezav s telefona in racunalnika v domacem omrezju -->
        <service
            android:name="si.safeer.tv.cast.CastReceiverService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Safeer Link (Hub): tece, dokler ga uporabnik ne ugasne, ne le med odprtim brskalnikom -->
        <service
            android:name="si.safeer.tv.cast.HubStoritev"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Safeer OS in druge sorodne aplikacije: vstop v Safeer Link brez kode (isti podpis) -->
        <service
            android:name="si.safeer.tv.cast.LinkSorodnikStoritev"
            android:exported="true"
            android:permission="si.safeer.tv.permission.LINK">
            <intent-filter>
                <action android:name="si.safeer.tv.LINK_SORODNIK" />
            </intent-filter>
        </service>

        <!-- Safeer Scit: filter DNS za ves televizor, v lastnem procesu (mapiran nabor domen, brez kopice brskalnika) -->
        <service
            android:name="si.safeer.tv.scit.ScitStoritev"
            android:exported="false"
            android:process=":scit"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="systemExempted">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
        <activity
            android:name="si.safeer.tv.scit.ScitActivity"
            android:exported="true"
            android:permission="si.safeer.tv.permission.LINK"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true" />
        <service
            android:name="si.safeer.tv.scit.ScitSorodnikStoritev"
            android:exported="true"
            android:permission="si.safeer.tv.permission.LINK">
            <intent-filter>
                <action android:name="si.safeer.tv.SCIT_SORODNIK" />
            </intent-filter>
        </service>

        <receiver
            android:name="si.safeer.tv.cast.ZagonPrejemnik"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="si.safeer.tv.MobileFileProvider"
            android:authorities="si.safeer.tv.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
