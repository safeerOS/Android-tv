<?xml version="1.0" encoding="utf-8"?>
<!-- Ena ploscica na domacem zaslonu tablice. Prst ni miska: cela ploscica je tipka, visoka
     najmanj 132 dp, z odzivom na dotik (foreground) in dovolj zraka okoli besedila. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="132dp"
    android:background="@drawable/os_kartica_mirna"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="18dp">

    <ImageView
        android:id="@+id/ikona"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:contentDescription="@null"/>

    <TextView
        android:id="@+id/ime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/os_besedilo"
        android:textSize="17sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/opis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/os_umirjeno"
        android:textSize="13sp"/>
</LinearLayout>
