<?xml version="1.0" encoding="utf-8"?>
<!-- Domaci zaslon Safeer OS Tablet: dotik od blizu, ne daljinec z dveh metrov.
     Zato ni fokusnih vrst, ampak mreza velikih ploscic, ki se prilagodi sirini zaslona
     (@integer/tablet_stolpci: dva stolpca pokoncno, trije na sirokem zaslonu). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/koren"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/os_ozadje"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/naslov"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/os_besedilo"
            android:textSize="30sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/podnaslov"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/os_umirjeno"
            android:textSize="15sp"/>

        <TextView
            android:id="@+id/stanje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/os_znacka"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="@color/os_mint"
            android:textSize="14sp"/>

        <GridLayout
            android:id="@+id/ploscice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:columnCount="@integer/tablet_stolpci"/>

        <TextView
            android:id="@+id/opomba"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/os_umirjeno"
            android:textSize="13sp"/>
    </LinearLayout>
</ScrollView>
