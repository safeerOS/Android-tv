<?xml version="1.0" encoding="utf-8"?>
<!-- Safeer OS Mobile (si.safeer.phone): ista koda kot televizor, a za dotik od blizu.
     Vse skupno je v AndroidManifest.xml v korenu; tu je samo, kar velja za tablico. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingLeanbackLauncher,UnsupportedTvHardware,UnnecessaryRequiredFeature">

    <!-- Navadno dovoljenje: Safeer lahko zahteva cellular Network tudi ob aktivnem Wi-Fi. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Tablica ni aplikacija za televizor: brez vnosa LEANBACK_LAUNCHER in z obveznim zaslonom na dotik
         (vmesnik tablice je narejen za dotik, zato ga zahtevamo namenoma). -->

    <!-- Tablica ni televizor: nicesar ne zahtevamo od leanback okolja. -->
    <uses-feature android:name="android.software.leanback" android:required="false" tools:node="replace" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" tools:node="replace" />

    <!-- Cesar lupina ne potrebuje: mikrofon je brskalnikov (glasovno iskanje). SYSTEM_ALERT_WINDOW
         ostane (iz skupnega manifesta): Safeer Link z druge naprave odpira programe tudi, ko lupina
         ni v ospredju (Android 10+); uporabnik ga vklopi sam, prek obvestila. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Safeer Vnos z ENO privolitvijo (lastnik 25. 10. 2026): ko uporabnik napravi v ozjem krogu odpre »Zaslon in
         upravljanje«, aplikacija sama vpise SVOJO storitev dostopnosti (link/VnosVklop). Dovoljenja uporabnik ne vidi in
         ga aplikacija ne more dobiti sama: podeli ga samo namestitev prek adb (install_safeer.sh, korak »upravljanje«). Brez
         njega ostane voden korak na stran Safeer Vnosa. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <!-- Vse datoteke za racunalnike v ozjem krogu (Safeer Link, link/DatotekeStreznik): posebni dostop »vse datoteke«,
         ki ga uporabnik vklopi sam v sistemskih nastavitvah za Safeer in ga tam tudi umakne. Safeer ni v Trgovini Play,
         zato njen pravilnik za to dovoljenje ne velja. Brez njega naprava deli samo medije (READ_MEDIA_*). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />

    <queries>
        <package android:name="si.safeer.tv" />
        <package android:name="com.safeer.mobile.browser" />
    </queries>

    <!-- largeHeap: zaganjalnik po vzoru TV (domaci zaslon, ikone, brskalnik, predvajalnik) potrebuje vecjo mejo pomnilnika. -->
    <application
        android:label="@string/telefon_ime"
        android:icon="@mipmap/os_ic_launcher"
        android:roundIcon="@mipmap/os_ic_launcher"
        android:largeHeap="true"
        tools:replace="android:largeHeap">

        <!-- Vstopna tocka: navaden vnos v predalu aplikacij, pokoncno in lezece. -->
        <activity
            android:name="si.safeer.tv.tablica.DomovTabletActivity"
            android:exported="true"
            android:label="@string/telefon_ime"
            tools:ignore="RedundantLabel"
            android:configChanges="orientation|screenSize|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Varnostna vrata na ikoni (dolg pritisk v katerem koli zaganjalniku): nazaj na tovarniski zaganjalnik / Safeer. -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/zaganjalnik_bliznjice" />
        </activity>

        <!-- Safeer zaganjalnik (lastnik, 25. 10. 2026): prilagodljiv domaci zaslon os/ZaganjalnikActivity - na majhnem zaslonu
             razporeditev za dotik, na tablici lezece, na zunanjem zaslonu in v DeX namizje kot Safeer OS na racunalniku.
             IZBIRA: vstopna tocka ostane DomovTabletActivity zgoraj; zaganjalnik je domaci zaslon sele, ko ga uporabnik izbere
             (Nastavitve - Domaci zaslon, sistemsko okno vloge). Varnostna vrata: os/VarnostnaVrata.kt. -->
        <activity
            android:name="si.safeer.tv.os.ZaganjalnikActivity"
            android:exported="true"
            android:label="@string/telefon_ime"
            android:theme="@style/Theme.SafeerOs"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|uiMode"
            tools:ignore="RedundantLabel" />

        <!-- Domaci zaslon (tipka Domov). Privzeto ONEMOGOCEN: Android Safeerja sploh ne ponudi, dokler ga uporabnik ne izbere;
             izklop ga spet onemogoci in Android vrne prejsnji zaganjalnik (tudi samodejno po padcih, os/Zaganjalnik.kt). -->
        <activity-alias
            android:name="si.safeer.tv.os.ZaganjalnikAlias"
            android:targetActivity="si.safeer.tv.os.ZaganjalnikActivity"
            android:exported="true"
            android:enabled="false"
            android:label="@string/telefon_ime"
            android:icon="@mipmap/os_ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Namizje na zunanjem zaslonu (SECONDARY_HOME): Android ga vzame iz paketa izbranega domacega zaslona. Svoja
             dejavnost singleTop, ker sistem domacega zaslona drugega zaslona ne odpre iz singleTask. Vklop skupaj z aliasom zgoraj. -->
        <activity
            android:name="si.safeer.tv.os.NamizjeActivity"
            android:exported="true"
            android:label="@string/telefon_ime"
            android:theme="@style/Theme.SafeerOs"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|uiMode"
            tools:ignore="RedundantLabel" />
        <activity-alias
            android:name="si.safeer.tv.os.NamizjeAlias"
            android:targetActivity="si.safeer.tv.os.NamizjeActivity"
            android:exported="true"
            android:enabled="false"
            android:label="@string/telefon_ime"
            android:icon="@mipmap/os_ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.SECONDARY_HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Varnostna vrata brez vmesnika (bliznjica ikone, ploscica): nicesar ne risa, zato dela tudi, ko se Safeer ne narise. -->
        <activity
            android:name="si.safeer.tv.os.VarnostnaVrataActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name="si.safeer.tv.os.VarnostnaVrataPloscica"
            android:exported="true"
            android:label="@string/nz_ploscica"
            android:icon="@drawable/os_ikona_domov"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>

        <!-- Skupni zasloni so na televizorju zaklenjeni v lezeco lego, ker je televizor vedno
             lezec. Tablico uporabnik drzi, kakor hoce: zasukati mu je ne smemo. Zato tu lego
             odstranimo (tools:remove); koda zaslonov ostane ista.

             Izjema je zaslon racunalnika: namizje je 16:9 in pokoncno bi bilo trak sredi crnine,
             zato ostane lezec (a v obe smeri, da ga lahko obrnes). -->
        <activity android:name="si.safeer.tv.os.DatotekeActivity"
            tools:remove="android:screenOrientation,android:taskAffinity" />
        <activity android:name="si.safeer.tv.os.NapraveActivity"
            tools:remove="android:screenOrientation,android:taskAffinity" />
        <activity android:name="si.safeer.tv.os.AplikacijeHostaActivity"
            tools:remove="android:screenOrientation,android:taskAffinity" />
        <activity android:name="si.safeer.tv.os.SporocilaActivity"
            tools:remove="android:screenOrientation,android:taskAffinity" />
        <activity android:name="si.safeer.tv.os.SpletniKlepetActivity"
            tools:remove="android:screenOrientation,android:taskAffinity" />
        <activity android:name="si.safeer.tv.os.ZapiskiActivity"
            tools:remove="android:screenOrientation,android:taskAffinity" />
        <activity android:name="si.safeer.tv.os.BesediloActivity"
            tools:remove="android:screenOrientation,android:taskAffinity" />
        <activity android:name="si.safeer.tv.os.SlikaActivity"
            tools:remove="android:screenOrientation,android:taskAffinity" />
        <activity android:name="si.safeer.tv.os.PredvajalnikActivity"
            tools:remove="android:screenOrientation,android:taskAffinity" />
        <activity android:name="si.safeer.tv.os.NastavitveActivity"
            tools:remove="android:screenOrientation,android:taskAffinity" />
        <activity android:name="si.safeer.tv.os.VidezActivity"
            tools:remove="android:screenOrientation,android:taskAffinity" />
        <activity android:name="si.safeer.tv.os.AplikacijeTvActivity"
            tools:remove="android:screenOrientation,android:taskAffinity" />
        <activity android:name="si.safeer.tv.os.ZaslonActivity"
            android:screenOrientation="sensorLandscape" tools:replace="android:screenOrientation"
            tools:ignore="DiscouragedApi" tools:remove="android:taskAffinity" />

        <!-- Telefon in tablica: vsi zasloni Safeer OS tecejo v ENEM opravilu z vstopno tocko (ena kartica med
             nedavnimi aplikacijami). Na televizorju imata brskalnik in Safeer OS vsak svoje opravilo (svoj vnos v
             zaganjalniku); tu je vnos en sam, zato je bilo drugo opravilo (.os) le podvojena kartica (9. 10. 2026). -->
        <!-- DomovActivity je tu le preusmeritev na DomovTabletActivity (Nazaj/Domov iz stranske vrstice); s svojim
             opravilom bi domaci zaslon odprla v drugi kartici. -->
        <activity android:name="si.safeer.tv.os.DomovActivity"
            tools:remove="android:taskAffinity" />
        <activity android:name="si.safeer.tv.os.GlasbaActivity"
            tools:remove="android:taskAffinity" />
        <activity android:name="si.safeer.tv.os.MagnetActivity"
            tools:remove="android:taskAffinity" />

        <!-- Brskalniski pogon je tu samo notranji (spletne aplikacije), brez vnosa v zaganjalnik. -->
        <activity
            android:name="si.safeer.tv.MainActivity"
            android:exported="false"
            android:label="@string/telefon_ime"
            android:icon="@mipmap/os_ic_launcher"
            android:banner="@drawable/os_banner"
            tools:replace="android:exported,android:label,android:icon,android:banner"
            tools:ignore="RedundantLabel" />

        <!-- Safeer Vnos: dotik in tipke z racunalnika na tablici (upravljanje aplikacije, ki jo tablica
             deli na racunalnik). Samo na tablici; uporabnik ga vklopi sam v nastavitvah dostopnosti. -->
        <service
            android:name="si.safeer.tv.link.VnosStoritev"
            android:label="@string/vnos_ime"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/safeer_vnos" />
        </service>

        <!-- "Deli" iz YouTuba ali Spotifyja: povezava seznama predvajanja se uvozi v sezname Medijskega centra.
             Vzdevek, ker je GlasbaActivity tu notranji zaslon (ni izvozen). -->
        <activity-alias
            android:name="si.safeer.tv.os.UvozSeznamaVhod"
            android:targetActivity="si.safeer.tv.os.GlasbaActivity"
            android:exported="true"
            android:label="@string/os_uvoz_naslov">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

    </application>
</manifest>
