<?xml version="1.0" encoding="utf-8"?>
<!-- Safeer OS (si.safeer.os): svoja aplikacija s svojim imenom, ikono in vnosom v zaganjalniku.
     Vse skupno je v AndroidManifest.xml v korenu. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Cesar Safeer OS ne potrebuje, tudi ne zahteva. Mikrofon in risanje cez druge aplikacije
         uporablja samo brskalnik (glasovno iskanje, daljinec); v skupnem manifestu sta zato, ker ga
         obe aplikaciji delita. Uporabnik naj ob namestitvi Safeer OS vidi samo tisto, kar ta res
         potrebuje. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <!-- Enako kot v skupnem delu; ponovljeno, ker Lint ta del preverja posebej. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <!-- Safeer Vnos z ENO privolitvijo (lastnik 25. 10. 2026): ko uporabnik napravi v ozjem krogu odpre »Zaslon in
         upravljanje«, aplikacija sama vpise SVOJO storitev dostopnosti (link/VnosVklop). Dovoljenja uporabnik ne vidi in
         ga aplikacija ne more dobiti sama: podeli ga samo namestitev prek adb (install_safeer.sh, korak »upravljanje«). Brez
         njega ostane voden korak na stran Safeer Vnosa. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <!-- SYSTEM_ALERT_WINDOW ostane (iz skupnega manifesta): Safeer OS sprejema ukaze Safeer Linka in
         odpre program, ki ga izbere seznanjena naprava (racunalnik, telefon). Android 10+ zagona iz ozadja
         brez tega dovoljenja ne dovoli ("Abort background activity starts"). Ne zahtevamo ga ob
         namestitvi - samo ob prvem zagonu na daljavo, z jasnim obvestilom. -->

    <!-- Safeer OS mora videti brskalnik: od njega dobi vstop v Safeer Link, Scit in odpiranje spleta. -->
    <queries>
        <package android:name="si.safeer.tv" />
    </queries>

    <!-- largeHeap (28. 10. 2026): TV ima 2 GB RAM; s privzeto mejo 192 MB (dalvik.vm.heapgrowthlimit) je ob predpomnjenju
         ikon, spletnih aplikacijah in predvajalniku prihajalo do OOM. largeHeap da mejo dalvik.vm.heapsize (512 MB). -->
    <application
        android:label="@string/os_app_name"
        android:icon="@mipmap/os_ic_launcher"
        android:roundIcon="@mipmap/os_ic_launcher"
        android:banner="@drawable/os_banner"
        android:largeHeap="true"
        tools:replace="android:largeHeap">

        <!-- Vstopna tocka v zaganjalniku televizorja -->
        <activity android:name="si.safeer.tv.os.DomovActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Prilagodljivi zaganjalnik (os/ZaganjalnikActivity, ista koda kot na telefonu in tablici) v nacinu za
             daljinec. Na televizorju je zaenkrat le za preizkus in meritve (adb am start -n); domaci zaslon televizorja
             ostane DomovActivity (ZaganjalnikAlias spodaj), dokler lastnik ne izbere drugace. -->
        <activity
            android:name="si.safeer.tv.os.ZaganjalnikActivity"
            android:exported="true"
            android:theme="@style/Theme.SafeerOs"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density|uiMode"
            tools:ignore="DiscouragedApi" />

        <!-- Safeer OS kot domaci zaslon televizorja. Privzeto ONEMOGOCEN: dokler ga uporabnik
             sam ne vklopi, Android sploh ne ve, da bi Safeer OS lahko bil zaganjalnik, in tipka
             Domov dela kot prej. Vklop in izklop sta v nastavitvah (os/Zaganjalnik.kt). -->
        <activity-alias
            android:name="si.safeer.tv.os.ZaganjalnikAlias"
            android:targetActivity="si.safeer.tv.os.DomovActivity"
            android:exported="true"
            android:enabled="false"
            android:label="@string/os_app_name"
            android:icon="@mipmap/os_ic_launcher"
            android:banner="@drawable/os_banner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Brskalnik je v tej aplikaciji samo notranji pogon za spletne aplikacije, kadar
             Safeer Browser ni namescen: brez vnosa v zaganjalniku in brez obravnave povezav. -->
        <activity
            android:name="si.safeer.tv.MainActivity"
            android:exported="false"
            android:label="@string/os_app_name"
            android:icon="@mipmap/os_ic_launcher"
            android:banner="@drawable/os_banner"
            tools:replace="android:exported,android:label,android:icon,android:banner"
            tools:ignore="RedundantLabel" />

        <!-- Zagon ob vklopu televizorja (privzeto nic: prejemnik najprej pogleda nastavitev). -->
        <receiver
            android:name="si.safeer.tv.os.ZagonPrejemnikOs"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Vrata za brskalnik: "Dodaj na domaci zaslon" iz njegovega menija pristane tukaj.
             Odprto samo aplikacijam z istim podpisom. -->
        <provider
            android:name="si.safeer.tv.os.SpletnePonudnik"
            android:authorities="${applicationId}.spletne"
            android:exported="true"
            android:permission="si.safeer.tv.permission.LINK" />

        <!-- Safeer Vnos: misko in tipkovnico z racunalnika v ozjem krogu (Safeer Control) prevede v izbiro, OK, Nazaj in
             Domov na televizorju. Do 25. 10. 2026 je bil samo na telefonu in tablici - televizor ga ni imel (izmerjeno
             10:44, si.safeer.os 0.5.110). Vklopi se z eno privolitvijo v Safeer Linku (link/VnosVklop). -->
        <service
            android:name="si.safeer.tv.link.VnosStoritev"
            android:label="@string/vnos_ime"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/safeer_vnos" />
        </service>

    </application>
</manifest>
